# Configure only the capabilities you intend to use.
DATA_COPILOT_PROVIDER_MAX_RETRIES=1

# Optional provider-backed Agent (DeepSeek example)
# DATA_COPILOT_PROVIDER=deepseek
# DATA_COPILOT_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Used only when DATA_COPILOT_PROVIDER=openai
# OPENAI_API_KEY=your-key-here

# Optional PostgreSQL capability; replace the placeholder locally.
# DATA_COPILOT_POSTGRES_DSN=your-postgresql-dsn-here
# POSTGRES_CONNECT_TIMEOUT_SECONDS=5
# POSTGRES_STATEMENT_TIMEOUT_MS=15000
